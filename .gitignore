# Ignore all generated STL files
cases/geometries/

# Ignore all generated OpenFOAM cases
cases/cases_run/

# Ignore logs and temporary files
logs/
*.log
*.tmp
*.swp

# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd


# Ignore OpenFOAM auto-generated files
cases/cases_run/*/processor*/  
cases/cases_run/*/log.*
cases/cases_run/*/postProcessing/
cases/cases_run/*/*.foam

# Allow only the OpenFOAM template folder
!cases/template/
!cases/template/**


# Ignore Python package metadata
*.egg-info/
doc/

# other files
*.png
*.stl
progress.md




# Openfoam
# Ignorar tudo dentro das pastas meshes e cases
meshes/*
cases/*

# Exceto arquivos de configuração ou scripts (caso necessário)
!meshes/**/*.stl
!cases/**/*.cfg
!cases/**/*.py

# Ignorar arquivos típicos do OpenFOAM
**/0/*
**/constant/polyMesh/*
**/processor*/**
**/system/*
**/dynamicCode/*
**/postProcessing/*
**/logs/*
**/*.OpenFOAM
**/*.foam
**/*.vtk
**/*.vtu
**/*.log
**/*.dat
**/*.bin
**/*.obj
**/*.case
